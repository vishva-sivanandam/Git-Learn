<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
<bean id="vishva" class="org.example.Vishva"/>
    <bean id="starName" class="org.example.Kamal"/>
    <bean id="suriya" class="org.example.Suriya"/>
    <bean id="vijay" class="org.example.Vijay" primary="true"/>

    <bean id="byName" class="org.example.Byname" autowire="constructor">
        <constructor-arg index="0" value="Visvha"/>
        <constructor-arg index="1" value="21"/>
    </bean>
</beans>